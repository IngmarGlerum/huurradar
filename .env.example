# Kopieer naar .env en vul in. .env staat in .gitignore en komt nooit in git.

# Supabase → Project Settings → API (of API Keys)
SUPABASE_URL=https://mvhktjcnclczmlgecmdb.supabase.co
# De secret key (sb_secret_...) of de oude service_role key. Nooit delen.
SUPABASE_SECRET_KEY=

# true = meldingen alleen loggen, niet versturen (handig om te testen)
DRY_RUN=false

# Optioneel: WhatsApp naar de beheerder als een bron blijft falen (CallMeBot, zie docs/handleiding.md)
ALERT_WHATSAPP_PHONE=
ALERT_CALLMEBOT_APIKEY=

# debug, info, warn of error
LOG_LEVEL=info
